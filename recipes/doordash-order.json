{
  "recipe": "glint.recipe/1",
  "id": "doordash-order",
  "rev": 2,
  "name": "doordash",
  "app": { "package": "com.dd.doordash", "label": "DoorDash" },
  "meta": {
    "status": "unverified",
    "author": "Glint",
    "updated": "2026-11-05",
    "notes": "The order notification as public reports describe it: ongoing, with a progress bar and an arrival time. Whether it is a Live Update is unconfirmed; channel ids are guesses. The arrival reads \"arrives in 12 min\"; once that time has passed, \"was due 9:52 am\" while the order is still on its bar."
  },
  "source": {
    "notification": {
      "match": {
        "notCategories": ["promo"],
        "anchors": ["(?i)order|dasher|on the way|arriving|delivered|preparing|picked up"],
        "exclude": ["(?i)\\b\\d+% off\\b|\\bpromo\\b|\\bdashpass\\b"],
        "lang": ["en"]
      },
      "key": "group",
      "pick": "ongoing",
      "merge": true,
      "hold": "2h",
      "expire": "6h"
    }
  },
  "fields": {
    "status": {
      "from": ["title"],
      "regex": "(?i)(?P<v>preparing|picked up|on the way|arriving|almost there|delivered|order confirmed|heading to)",
      "lang": ["en"],
      "then": ["lower"],
      "map": { "heading to": "on the way", "order confirmed": "confirmed", "almost there": "arriving" },
      "required": true
    },
    "eta": { "from": ["text", "bigText", "subText"], "regex": "(?i)(?P<v>\\d{1,2}:\\d{2}\\s*[AaPp]\\.?[Mm]\\.?)", "lang": ["en"], "then": ["time"], "stale": "1h" },
    "store": { "from": ["text", "bigText"], "regex": "(?i)\\bfrom\\s+(?P<v>[^.,]{2,40})", "lang": ["en"], "then": ["lower", "shorten:24"] }
  },
  "faces": [
    { "kind": "progress", "title": "{status}", "line": "arrives {eta|in}", "value": "{progress}", "max": "{max}", "when": ["status", "eta", "progress"] },
    { "kind": "progress", "title": "{status}", "line": "was due {eta|clock}", "value": "{progress}", "max": "{max}", "when": ["status", "eta", "progress", "status!=delivered"] },
    { "kind": "headline", "title": "{status}", "line": "arrives {eta|in}", "peek": "{store}", "when": ["status", "eta"] },
    { "kind": "headline", "title": "{status}", "line": "{store}", "when": ["status", "store"] },
    { "kind": "headline", "title": "{status}", "line": "doordash", "when": "status" }
  ],
  "tap": "notification"
}
