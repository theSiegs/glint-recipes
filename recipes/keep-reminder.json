{
  "recipe": "glint.recipe/1",
  "id": "keep-reminder",
  "rev": 2,
  "name": "keep",
  "app": { "package": "com.google.android.keep", "label": "Google Keep" },
  "meta": {
    "status": "built-in",
    "author": "Glint",
    "updated": "2026-11-03",
    "notes": "Built in, from public knowledge; still to be checked on real samples. Keep's reminders: category reminder, the note's title as the title, its first words as the text, the reminder's time as when. The same shape as tasks-reminder. The category isn't relied on (reminder when set): share notices, sync and system ones are left out."
  },
  "source": {
    "notification": {
      "match": {
        "notCategories": ["promo", "recommendation", "sys", "status", "err", "social", "progress", "email", "msg", "call"],
        "ongoing": "never",
        "progress": "never",
        "exclude": ["(?i)\\bshared\\b.{0,40}\\bwith you\\b|\\binvited you\\b|^sync"],
        "lang": ["en"]
      },
      "key": "id",
      "expire": "1d"
    }
  },
  "fields": {
    "note": { "from": ["title", "text"], "then": ["firstLine", "lower", "shorten:40"] }
  },
  "faces": [
    { "kind": "headline", "title": "{note}", "line": "reminder · {at}", "when": "at" },
    { "kind": "headline", "title": "{note}", "line": "reminder", "when": "!at" },
    { "kind": "count", "count": "{count}", "label": "reminders", "when": "count>1" }
  ],
  "tap": "notification"
}
