{
  "recipe": "glint.recipe/1",
  "id": "youtube-new",
  "rev": 4,
  "name": "youtube",
  "app": { "package": "com.google.android.youtube", "label": "YouTube" },
  "meta": {
    "status": "built-in",
    "author": "Glint",
    "updated": "2026-11-05",
    "notes": "Built in, from public knowledge; still to be checked on real samples. On (owner 2026-11-04): new videos as a count. Upload and download progress gets its own face. The latest video's thumbnail is the count's background from Large up, and its channel the quiet line."
  },
  "enabled": true,
  "source": {
    "notification": {
      "match": { "notCategories": ["promo", "recommendation"] },
      "key": "id",
      "expire": "1d"
    }
  },
  "fields": {
    "creator": { "from": ["title"], "regex": "^(?P<v>[^:\\n]{1,40}?)\\s+uploaded\\b", "lang": ["en"], "then": ["shorten:24"] }
  },
  "faces": [
    { "kind": "progress", "title": "uploading", "value": "{percent}", "line": "{percent}", "when": "progress" },
    { "kind": "count", "count": "{count}", "label": "new videos", "peek": "latest from {creator}", "picture": "picture", "when": "count>1" },
    { "kind": "count", "count": "{count}", "label": "new video", "peek": "from {creator}", "picture": "picture", "when": "count==1" }
  ],
  "tap": "notification"
}
