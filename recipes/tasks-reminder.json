{
  "recipe": "glint.recipe/1",
  "id": "tasks-reminder",
  "rev": 2,
  "name": "tasks",
  "app": { "package": "com.google.android.apps.tasks", "label": "Google Tasks" },
  "meta": {
    "status": "built-in",
    "author": "Glint",
    "updated": "2026-11-03",
    "notes": "Built in, from public knowledge; still to be checked on real samples. Due-task reminders: category reminder, the task as the title, a due line as the text. The same shape as keep-reminder. The category isn't relied on (reminder when set): tasks assigned from Docs or Chat, sync and system ones are left out."
  },
  "source": {
    "notification": {
      "match": {
        "notCategories": ["promo", "recommendation", "sys", "status", "err", "social", "progress", "email", "msg", "call"],
        "ongoing": "never",
        "progress": "never",
        "exclude": ["(?i)\\bassigned (?:you|to you)\\b|\\bshared\\b.{0,40}\\bwith you\\b|^sync"],
        "lang": ["en"]
      },
      "key": "id",
      "expire": "1d"
    }
  },
  "fields": {
    "task": { "from": ["title"], "then": ["firstLine", "lower", "shorten:40"] },
    "due": { "from": ["text"], "regex": "(?i)(?P<v>due\\s.{1,24}|overdue)", "lang": ["en"], "then": ["lower"] }
  },
  "faces": [
    { "kind": "headline", "title": "{task}", "line": "{due}", "when": "due" },
    { "kind": "headline", "title": "{task}", "line": "due {at}", "when": ["!due", "at"] },
    { "kind": "headline", "title": "{task}", "line": "task", "when": ["!due", "!at"] },
    { "kind": "count", "count": "{count}", "label": "tasks due", "when": "count>1" }
  ],
  "tap": "notification"
}
