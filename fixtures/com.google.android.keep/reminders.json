{
  "fixture": 1,
  "package": "com.google.android.keep",
  "source": "synthetic",
  "scrubbed": true,
  "notes": "Synthetic reminders: a later one (its clock time), one that just went off (minutes ago), an untitled one.",
  "samples": [
    {
      "name": "timed reminder",
      "notification": {
        "posted": 1767000000000, "when": 1767024000000, "category": "reminder", "channel": "reminders",
        "title": "Call the dentist", "text": "Ask about the Thursday opening",
        "actions": [ { "title": "Done" }, { "title": "Snooze" } ]
      },
      "expect": { "title": "call the dentist", "line": "reminder · 4:00 pm", "faces": 1 }
    },
    {
      "name": "just went off",
      "notification": { "posted": 1767000000000, "when": 1767000000000, "category": "reminder", "title": "Take the bread out" },
      "now": 1767000300000,
      "expect": { "title": "take the bread out", "line": "reminder · 5 min ago" }
    },
    {
      "name": "untitled note",
      "notification": { "posted": 1767000000000, "category": "reminder", "text": "Water the plants" },
      "expect": { "title": "water the plants", "line": "reminder" }
    },
    {
      "name": "share notice",
      "notification": { "posted": 1767000000000, "category": "social", "title": "Sam shared a note with you", "text": "Groceries" },
      "expect": { "match": false }
    }
  ]
}
