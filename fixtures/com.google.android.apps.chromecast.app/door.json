{
  "fixture": 1,
  "package": "com.google.android.apps.chromecast.app",
  "source": "synthetic",
  "scrubbed": true,
  "notes": "Synthetic camera and doorbell events (the snapshot behind the face), a door left open and then closed, and an app notice that must be left alone.",
  "samples": [
    {
      "name": "doorbell",
      "notification": { "posted": 1767000000000, "category": "call", "template": "BigPictureStyle", "hasPicture": true, "title": "Front door", "text": "Someone is at the door" },
      "expect": { "title": "someone at the door", "line": "front door · 1 min ago", "picture": true }
    },
    {
      "name": "person",
      "notification": { "posted": 1767000000000, "category": "event", "template": "BigPictureStyle", "title": "Driveway", "text": "Person seen" },
      "expect": { "title": "person seen", "line": "driveway · 1 min ago", "picture": false }
    },
    {
      "name": "package",
      "notification": { "posted": 1767000000000, "category": "event", "title": "Front door", "text": "Package detected" },
      "expect": { "title": "package seen" }
    },
    {
      "name": "door opened",
      "notification": { "posted": 1767000000000, "category": "event", "title": "Back door", "text": "Opened" },
      "now": 1767007500000,
      "expect": { "title": "back door open", "line": "since 9:20 am" }
    },
    {
      "name": "door unlocked",
      "notification": { "posted": 1767000000000, "category": "event", "title": "Front door", "text": "Front door unlocked" },
      "expect": { "title": "front door unlocked", "line": "since 9:20 am" }
    },
    {
      "name": "door closed",
      "notification": { "posted": 1767000000000, "category": "event", "title": "Back door", "text": "Closed" },
      "expect": { "match": false }
    },
    {
      "name": "app notice",
      "notification": { "posted": 1767000000000, "title": "New features for your home", "text": "Try the new camera history view." },
      "expect": { "match": false }
    }
  ]
}
